{
  "flow_id": null,
  "name": "GitHub PR Automation",
  "description": "Automatically create GitHub PRs and issues from form submissions",
  "version": 1,
  "graph": {
    "pages": [],
    "nodes": [
      {
        "id": "trigger_webhook",
        "category": "trigger",
        "type": "http.webhook",
        "name": "Feature Request Form",
        "connector": null,
        "operation": null,
        "params": {
          "path": "/hooks/feature-request",
          "method": "POST"
        },
        "inputs": [],
        "outputs": ["body"],
        "ui_hints": {
          "x": 100,
          "y": 100,
          "summary": "Webhook for feature requests"
        }
      },
      {
        "id": "create_issue",
        "category": "action",
        "type": "github.createIssue",
        "name": "Create GitHub Issue",
        "connector": "github",
        "operation": "createIssue",
        "params": {
          "repo": "yourorg/your-repo",
          "title": "Feature Request: {{trigger_webhook.body.feature_name}}",
          "body": "**Requested by:** {{trigger_webhook.body.email}}\n\n**Description:**\n{{trigger_webhook.body.description}}\n\n**Priority:** {{trigger_webhook.body.priority}}",
          "labels": ["feature-request", "community"]
        },
        "inputs": [
          {
            "from": "trigger_webhook",
            "port": "body"
          }
        ],
        "outputs": ["result"],
        "retry": {
          "max_attempts": 3,
          "strategy": "exponential"
        },
        "ui_hints": {
          "x": 300,
          "y": 100,
          "summary": "Create issue in GitHub"
        }
      },
      {
        "id": "notify_slack",
        "category": "action",
        "type": "slack.postMessage",
        "name": "Notify Team",
        "connector": "slack",
        "operation": "postMessage",
        "params": {
          "channel": "#product",
          "text": "📝 New feature request!\n\n*{{trigger_webhook.body.feature_name}}*\n\nIssue: {{create_issue.result.url}}\nRequested by: {{trigger_webhook.body.email}}\nPriority: {{trigger_webhook.body.priority}}"
        },
        "inputs": [
          {
            "from": "create_issue",
            "port": "result"
          }
        ],
        "outputs": ["message"],
        "ui_hints": {
          "x": 500,
          "y": 100,
          "summary": "Notify product team"
        }
      },
      {
        "id": "save_to_airtable",
        "category": "action",
        "type": "airtable.createRecord",
        "name": "Track in Airtable",
        "connector": "airtable",
        "operation": "createRecord",
        "params": {
          "base_id": "your-base-id",
          "table": "Feature Requests",
          "fields": {
            "Feature Name": "{{trigger_webhook.body.feature_name}}",
            "Description": "{{trigger_webhook.body.description}}",
            "Requested By": "{{trigger_webhook.body.email}}",
            "Priority": "{{trigger_webhook.body.priority}}",
            "GitHub Issue": "{{create_issue.result.url}}",
            "Status": "New"
          }
        },
        "inputs": [
          {
            "from": "create_issue",
            "port": "result"
          }
        ],
        "outputs": ["result"],
        "ui_hints": {
          "x": 500,
          "y": 250,
          "summary": "Save to tracking database"
        }
      }
    ],
    "connections": [
      {
        "from": "trigger_webhook",
        "to": "create_issue"
      },
      {
        "from": "create_issue",
        "to": "notify_slack"
      },
      {
        "from": "create_issue",
        "to": "save_to_airtable"
      }
    ],
    "triggers": [
      {
        "id": "t1",
        "type": "http.webhook",
        "config": {},
        "to_node": "create_issue"
      }
    ]
  },
  "metadata": {
    "owner": "dev-team@example.com",
    "created_at": "2025-11-15T00:00:00Z",
    "tags": ["github", "automation", "feature-requests"]
  }
}
