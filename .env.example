# UWG Engine Environment Variables

# ============================================
# CONNECTORS
# ============================================

# Slack
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# Anthropic Claude AI
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# Webflow
WEBFLOW_API_KEY=your-webflow-api-key

# Netlify
NETLIFY_SITE_ID=your-netlify-site-id
NETLIFY_BUILD_HOOK=your-netlify-build-hook-url

# Airtable
AIRTABLE_API_KEY=your-airtable-api-key

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# GitHub
GITHUB_TOKEN=ghp_your-github-token

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1

# SMTP (for email connector)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ============================================
# ENGINE CONFIGURATION
# ============================================

# Maximum parallel node execution
MAX_PARALLELISM=6

# Default node timeout (seconds)
DEFAULT_NODE_TIMEOUT=30

# Maximum flow execution time (seconds)
MAX_FLOW_EXECUTION_TIME=600

# ============================================
# API SERVER (when implemented)
# ============================================

PORT=3000
NODE_ENV=development

# Database (for flow storage)
DATABASE_URL=postgresql://user:pass@localhost:5432/uwg_engine

# Secret for webhook signing
WEBHOOK_SECRET=your-random-secret-here

# ============================================
# OBSERVABILITY
# ============================================

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Enable detailed execution logs
ENABLE_DETAILED_LOGS=true
