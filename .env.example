# UWG Engine Environment Variables

# ============================================
# CONNECTORS
# ============================================

# Slack
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# Anthropic Claude AI
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# Webflow
WEBFLOW_API_KEY=your-webflow-api-key

# Netlify
NETLIFY_API_KEY=your-netlify-api-key
NETLIFY_SITE_ID=your-netlify-site-id
NETLIFY_BUILD_HOOK=your-netlify-build-hook-url

# Airtable
AIRTABLE_API_KEY=your-airtable-api-key

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# GitHub
GITHUB_TOKEN=ghp_your-github-token

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1

# SMTP (for email connector)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ============================================
# ENGINE CONFIGURATION
# ============================================

# Maximum parallel node execution
MAX_PARALLELISM=6

# Default node timeout (seconds)
DEFAULT_NODE_TIMEOUT=30

# Maximum flow execution time (seconds)
MAX_FLOW_EXECUTION_TIME=600

# ============================================
# API SERVER
# ============================================

PORT=3000
NODE_ENV=development
INSTANCE_ID=api_1

# CORS configuration
CORS_ORIGIN=*

# Secret for webhook signing
WEBHOOK_SECRET=your-random-secret-here

# ============================================
# STORAGE CONFIGURATION
# ============================================

# Storage type: sqlite | postgres
STORAGE_TYPE=sqlite

# SQLite (default for development)
DATABASE_PATH=./data/uwg.db

# PostgreSQL (recommended for production)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=uwg
POSTGRES_USER=uwg
POSTGRES_PASSWORD=changeme
POSTGRES_SSL=false
# Connection pool size
POSTGRES_MAX_CONNECTIONS=20

# ============================================
# REDIS (Cache & Queue)
# ============================================

# Redis connection
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Cache settings
REDIS_KEY_PREFIX=uwg:
REDIS_DEFAULT_TTL=3600

# ============================================
# JOB QUEUE
# ============================================

# Queue name
QUEUE_NAME=uwg:flows

# Worker settings
WORKER_ID=worker_1
WORKER_CONCURRENCY=5

# Job retry configuration
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_TYPE=exponential
JOB_BACKOFF_DELAY=2000

# ============================================
# RATE LIMITING
# ============================================

# Enable distributed rate limiting (requires Redis)
DISTRIBUTED_RATE_LIMIT=true

# Global API rate limit (requests per 15 minutes)
RATE_LIMIT_API=100

# Flow execution rate limit (requests per minute)
RATE_LIMIT_EXECUTION=30

# Webhook rate limit (requests per minute)
RATE_LIMIT_WEBHOOK=100

# ============================================
# METRICS & MONITORING
# ============================================

# Enable Prometheus metrics
METRICS_ENABLED=true
METRICS_PORT=9090

# Grafana settings
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ============================================
# OBSERVABILITY
# ============================================

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Enable detailed execution logs
ENABLE_DETAILED_LOGS=true

# ============================================
# CONNECTION POOLING
# ============================================

# HTTP connection pool settings
HTTP_POOL_MIN=2
HTTP_POOL_MAX=10
HTTP_POOL_IDLE_TIMEOUT=30000

# ============================================
# WORKER POOL (Multi-Process)
# ============================================

# Number of worker processes (0 = CPU cores)
WORKER_COUNT=0

# Auto-restart failed workers
WORKER_AUTO_RESTART=true

# Maximum worker restarts
WORKER_MAX_RESTARTS=5

# ============================================
# PRODUCTION SETTINGS
# ============================================

# Enable cluster mode
CLUSTER_MODE=false

# Health check interval (ms)
HEALTH_CHECK_INTERVAL=30000

# Graceful shutdown timeout (ms)
SHUTDOWN_TIMEOUT=30000
